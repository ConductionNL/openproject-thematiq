<%# The asset precompile step does nothing for plugins on the official image, so the CSS is inlined.
    The design system can differ per project (docs/design/scopes.md). Turbo keeps the head between visits and only
    adds style tags, so the plugin's tags are tracked: when they differ on the next page, Turbo loads it whole. %>
<% OpenProject::Thematiq.scope_page(project: local_assigns[:project], controller: local_assigns[:controller]) %>
<style id="openproject-thematiq" data-plugin-version="<%= OpenProject::Thematiq::VERSION %>" data-turbo-track="reload">
<%= raw OpenProject::Thematiq.stylesheet %>
</style>
<%# A module's own design system reaches the content area only. %>
<% content_css = OpenProject::Thematiq.content_stylesheet %>
<% if content_css %>
<style id="openproject-thematiq-content" data-turbo-track="reload">
<%= raw content_css %>
</style>
<% end %>
<%# The fonts of the active design system. They are files the plugin serves itself, under /thematiq/. %>
<% asset_css = OpenProject::Thematiq.asset_stylesheet(root: OpenProject::Configuration["rails_relative_url_root"].to_s) %>
<% if asset_css.present? %>
<style id="openproject-thematiq-assets" data-turbo-track="reload">
<%= raw asset_css %>
</style>
<% end %>
<%= render partial: "thematiq/shell/head" %>
<%# The icon pack for the frontend module (frontend route only): data, never run. Tracked, so a page with another
    pack loads whole and the module draws it from the start. %>
<% icon_pack_payload = OpenProject::Thematiq.icon_pack_payload %>
<% if icon_pack_payload %>
<script type="application/json" id="thematiq-icon-pack-data" data-turbo-track="reload"><%= raw ERB::Util.json_escape(icon_pack_payload) %></script>
<% end %>
<%# The sign-in page's background, when the design system has one uploaded. %>
<% login_background = (OpenProject::Thematiq::Assets.bundled.login_background_css(OpenProject::Thematiq.active_token_set, root: OpenProject::Configuration["rails_relative_url_root"].to_s) rescue "") %>
<% if login_background.present? %>
<style id="openproject-thematiq-login-background" data-turbo-track="reload"><%= raw login_background %></style>
<% end %>
<%# The organisation's own tokens, --thematiq-org-*, from checked values. %>
<% own_tokens_css = (OpenProject::Thematiq::Store.new.own_tokens_css rescue nil) %>
<% if own_tokens_css %>
<style id="openproject-thematiq-own-tokens" data-turbo-track="reload">
<%= raw own_tokens_css %>
</style>
<% end %>
<%# The administrator's own CSS, last, so it wins. Off by default; written anew from checked parts (CustomCss). %>
<% own_css = (OpenProject::Thematiq::Store.new.served_custom_css rescue nil) %>
<% if own_css %>
<style id="openproject-thematiq-custom" data-turbo-track="reload">
<%= raw own_css %>
</style>
<% end %>
<%# After OpenProject's own favicon link, so a browser that takes the last one takes this. %>
<%= render partial: "thematiq/hooks/icons" %>
