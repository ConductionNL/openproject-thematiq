<% html_title t(:label_administration), t("thematiq.admin.title") %>
<% active = @store.active_token_set %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("thematiq.admin.title") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       t("thematiq.admin.title")]
    )
    header.with_description { t("thematiq.admin.description") }
  end
%>

<%= render(Primer::Beta::Subhead.new) do |component|
  component.with_heading(tag: :h3, size: :medium) { t("thematiq.admin.active_design_system") }
end %>

<%= render(AttributeGroups::AttributeGroupComponent.new) do |component|
  component.with_attribute(key: t("thematiq.admin.name"), value: active.name)
end %>
