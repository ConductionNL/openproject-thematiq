{
  "global": {
    "brand": { "blue": { "value": "#0055aa", "type": "color", "description": "The brand blue" } },
    "nldesign": {
      "color": {
        "primary": { "value": "{brand.blue}", "type": "color" },
        "link": { "value": "{nldesign.color.primary}", "type": "color" }
      },
      "font": { "family": { "value": "'Fira Sans', sans-serif", "type": "fontFamilies" } },
      "border": { "radius": { "value": "{spacing.base} * 2", "type": "borderRadius" } }
    },
    "spacing": { "base": { "value": "4px", "type": "spacing" } }
  },
  "dark": {
    "nldesign": { "color": { "background": { "value": "#101010", "type": "color" } } }
  },
  "$metadata": { "tokenSetOrder": ["global", "dark"] }
}
